/target
/.cargo/
node_modules/

# Per-install shared secret, generated on first run by src/auth.rs. Never
# check this in -- see docs/protocol.md#trust-model--authentication.
/config/secret.token

# Per-install spotlight usage stats (src/spotlight.rs's Frecency), written
# next to secret.token in whatever --config-dir the daemon was started
# with. Runtime state, not configuration -- never check this in.
/config/spotlight_frecency.json

#!/usr/bin/env bash
# Raw test client for the keylex/v0 socket protocol (docs/protocol.md):
# sends {"command": "<arg>"} straight to the VS Code extension's listening
# socket (extensions/vscode-extension/extension.js), bypassing the Rust
# daemon's action-id/registry layer entirely. For poking at the extension
# directly with any VS Code command id while actions.toml is still being
# reworked.
#
# No authentication on the wire right now -- see
# docs/protocol.md#trust-model--authentication and CLAUDE.md's "Known gaps".
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: ./run <vscode-command-id>" >&2
  echo "example: ./run workbench.action.closeActiveEditor" >&2
  exit 1
fi

HOST=127.0.0.1
PORT=7777
COMMAND="$1"

exec 3<>"/dev/tcp/$HOST/$PORT"
printf '{"command":"%s"}\n' "$COMMAND" >&3
exec 3<&- 3>&-

echo "sent: $COMMAND"

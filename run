#!/usr/bin/env bash
# Raw test client for the keylex/v0 socket protocol (docs/protocol.md):
# sends {"command": "<arg>", "token": "<secret>"} straight to the VS Code
# extension's listening socket (extensions/vscode-extension/extension.js),
# bypassing the Rust daemon's action-id/registry layer entirely. For poking
# at the extension directly with any VS Code command id while actions.toml
# is still being reworked.
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: ./run <vscode-command-id>" >&2
  echo "example: ./run workbench.action.closeActiveEditor" >&2
  exit 1
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOKEN_FILE="$DIR/config/secret.token"
HOST=127.0.0.1
PORT=7777
COMMAND="$1"

if [ ! -f "$TOKEN_FILE" ]; then
  echo "run: no token file at $TOKEN_FILE -- run 'cargo run -- --demo' once to generate it" >&2
  exit 1
fi

TOKEN="$(<"$TOKEN_FILE")"

exec 3<>"/dev/tcp/$HOST/$PORT"
printf '{"command":"%s","token":"%s"}\n' "$COMMAND" "$TOKEN" >&3
exec 3<&- 3>&-

echo "sent: $COMMAND"
